# Campus Guide 3D — Environment Variables
# Copy to .env.local and fill in values

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/campusguide?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_SECRET=generate-a-32-char-minimum-secret-here
NEXTAUTH_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CAMPUS_MODEL_URL=/models/campus.glb

# Optional: Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
